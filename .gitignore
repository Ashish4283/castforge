.venv/
asset_packs/
asset_packs_unused/
models/
test/
movies/
sfx/
# tools/ holds third-party binaries (Rhubarb and friends), which do not belong in the repo - but our
# OWN scripts live there too, and they were being silently dropped by `git add -A`. A notebook in the
# repo whose generator is not is worse than neither.
# ...and it must be tools/* rather than tools/, because git does not descend into an excluded
# DIRECTORY at all, so a negation inside one never fires.
tools/*
!tools/*.py
!tools/kaggle/
tools/kaggle/*
!tools/kaggle/*.py
asset_index.json
__pycache__/
.pytest_cache/
.app.pid
*.py[cod]
*.blend
!library/**/*.blend
*.blend1
*.mp4
*.wav
library/**/build.log
library/**/*.tmp
motions/
web/node_modules/

# preview kits: machine-made bodies for the designer's live view, 2.4 MB each, remade in 9 seconds
library/preview_kits/
# Generated cloth: about 4 MB a fabric, and every one of them can be made again from its prompt
# (generate/remote_gpu.py) or in code (generate/make_fabric.py --demo). Data, not source.
library/fabrics/
.gpu.json
